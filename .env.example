# --- AI provider: set ONE key. Gemini has a free tier (no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=gemini            # or anthropic. If unset, whichever key is present is used (Gemini first).
# Optional model overrides (Gemini defaults are free-tier eligible; each model has its OWN free quota):
# ANALYZE_MODEL=gemini-3.5-flash-lite   # gemini-3.8-flash is better but was overloaded (503/timeouts) in testing
# DATE_MODEL=gemini-3.5-flash-lite
# VERDICT_MODEL=gemini-3.1-flash-lite
# GEMINI_RPM=10                  # pace requests per model per process to stay under your free-tier RPM

# --- Scraping: Apify token (https://console.apify.com/account/integrations)
APIFY_TOKEN=
# APIFY_LINKEDIN_ACTOR=apimaestro~linkedin-profile-detail
# APIFY_INSTAGRAM_ACTOR=apify~instagram-profile-scraper

# --- Abuse protection
# RATE_LIMIT_SCALE=1

# DEV ONLY: LLM_MODE=fixture returns clearly-labelled synthetic output (no model called). Never for the real demo.
# LLM_MODE=
